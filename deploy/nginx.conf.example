# DailyEnglish Nginx 站点配置模板
#
# 用法：
#   1. 把本文件复制到服务器，替换 server_name 为你的域名
#   2. 放到 /etc/nginx/sites-available/dailyenglish，软链到 sites-enabled
#   3. 把前端构建产物放到下面的 root 目录（见 deploy.sh）
#   4. nginx -t && systemctl reload nginx
#
# 结构：静态文件由 Nginx 直接服务，/api 反向代理到本机 uvicorn。

server {
    listen 80;
    listen [::]:80;
    server_name example.com;   # TODO: 改成你的域名

    root /var/www/dailyenglish;
    index index.html;

    # 后端 API 反向代理（uvicorn 监听本机 8000，不对外暴露）
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA 路由回落：/articles/1 等前端路由都落到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存（带 hash 的构建产物）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
